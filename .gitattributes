# Source files use LF everywhere.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.png binary
*.gif binary
*.xlsx binary
# Keep the sample data and test files byte-for-byte identical on every OS: findings quote exact lines, CI checks that
# scripts/make_data.py reproduces data/ exactly, and the export pack holds CRLF and UTF-16 files on purpose. Git must
# never rewrite their line endings. (Last, so these win over the rules above.)
data/** -text
tests/cases/** -text
tests/exports/** -text
docs/example-exports/** -text
